# Optional: JSON endpoint for the Contact / Join forms (Formspree, Web3Forms, own API).
# Leave unset to fall back to a prefilled mailto: link.
VITE_FORMS_ENDPOINT=

# Ported auth/onboarding funnel — mynt-customer-backend base URL and the CFD
# dashboard origin the post-login handoff sends finished customers to.
VITE_API_URL=https://api.pyvotmynt.in
VITE_DASHBOARD_URL=https://app.pyvotmynt.in
